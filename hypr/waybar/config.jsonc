{
    // Omit "output" so the bar follows the focused/primary monitor on any machine
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "hyprland/language",
        "custom/monitor-layout",
        "custom/local-ai",
        "network",
        "pulseaudio",
        "backlight",
        "battery"
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": true,
        "sort-by": "number",
        "move-to-monitor": true,
        "persistent-workspaces": {
            "*": 10
        }
    },
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "actions": {
            "on-scroll-down": "shift_up",
            "on-scroll-up": "shift_down",
            "on-click-middle": "shift_reset",
            "on-click-right": "mode"
        },
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6600'><b><u>{}</u></b></span>"
            }
        }
    },
    "battery": {
        "interval": 5,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{timeTo}\nPower: {power:.1f}W"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-it": "IT",
        "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
    },
    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid}\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },
    "backlight": {
        "format": "󰃟 {percent}%"
    },
    "custom/monitor-layout": {
        "format": "{icon}",
        "format-icons": {
            "extend": "󰍹",
            "mirror": "󰍺"
        },
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/monitor-layout-status",
        "interval": 2,
        "on-click": "~/.config/hypr/scripts/toggle-monitor-layout",
        "tooltip": true
    },
    // Optional widget, left of the network one. It is per-machine, so it is enabled
    // with an untracked flag file instead of a change to this tracked config:
    //   touch ~/.config/waybar/local-ai.enabled   # show
    //   rm    ~/.config/waybar/local-ai.enabled   # hide
    "custom/local-ai": {
        "return-type": "json",
        "exec": "/home/mikymod/work/mikymod/omarchy-local-ai/arch/waybar/local-ai.sh",
        "exec-if": "test -f ~/.config/waybar/local-ai.enabled",
        "interval": 5,
        "on-click": "/home/mikymod/work/mikymod/omarchy-local-ai/arch/bin/local-ai-qs toggle",
        "tooltip": true
    },
    "tray": {
        "spacing": 10
    }
}
