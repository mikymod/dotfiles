macos-non-native-fullscreen = true
macos-option-as-alt = true

window-inherit-font-size = false

font-family = FiraCode Nerd Font
font-size = 14

background = #282828
foreground = #d4be98
selection-background = #45403d
selection-foreground = #282828
cursor-color = #e78a4e
cursor-text = #282828
# gruvbox-material (dark, medium bg, material fg)
palette = 0=#282828
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#928374
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#ddc7a1

keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:bottom
keybind = ctrl+a>k=goto_split:top
keybind = ctrl+a>l=goto_split:right
keybind = ctrl+a>shift+\=new_split:right
keybind = ctrl+a>shift+-=new_split:down

keybind = ctrl+a>t=new_tab
keybind = ctrl+a>shift+t=close_tab
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

keybind = ctrl+a>x=close_surface

keybind = ctrl+a>r=reload_config
